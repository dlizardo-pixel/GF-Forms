      "id": "a0000000-0000-4000-9000-000000000032",
      "name": "Controller DB abfragen",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        1300,
        140
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
