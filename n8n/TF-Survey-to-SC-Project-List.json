      ],
      "id": "a0000000-0000-4000-9000-000000000030",
      "name": "Inverter DB abfragen",
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "notionOAuth2Api": {
          "id": "MtXhNqA8ov0rMxcj",
          "name": "Notion OAuth2 API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Ampel Inverter: Serie/Modell gegen die Inverter DB pruefen.\n// Mehrere Werte sind mit ', ' getrennt (Multi-Select-Format).\n// Zurueckgeschrieben werden NUR Treffer aus der DB -> keine neuen Optionen.\n\nconst entries = $input.all();\nconst row = $('Loop Over Items').first().json;\nconst pageId = $('Seite anlegen').first().json.id;\n\nconst norm = (s) => (s || '').trim().toLowerCase();\nconst split = (v) => (v || '').split(',').map((s) => s.trim()).filter(Boolean);\n\nconst manufacturers = split(row['PV-Wechselrichter Hersteller']);\nconst seriesList = split(row['PV-Wechselrichter Modell / Serie']);\n\nconst AMPEL = { '🟢': '🟢 Grün', '🟡': '🟡 Gelb', '🔴': '🔴 Rot' };\nconst RANK = { '🟢 Grün': 1, '🟡 Gelb': 2, '🔴 Rot': 3 };\nconst SKIP_NO_DATA = '⚪ Skipped: no manufacturer/series data';\nconst SKIP_NOT_FOUND = '⚪ Skipped: device not in Inverter DB';\n\nlet ampel = null;\nconst matchedSeries = [];\n\nif (!manufacturers.length || !seriesList.length) {\n  ampel = SKIP_NO_DATA;\n} else {\n  for (const wanted of seriesList) {\n    const hit = entries.find((e) => {\n      const series = e.json.property_series || '';\n      const models = e.json.property_models || '';\n      if (series && norm(series) === norm(wanted)) return true;\n      return models.split(',').map((m) => m.trim()).some((m) => norm(m) === norm(wanted));\n    });\n    if (!hit) continue;\n    matchedSeries.push(hit.json.property_series || wanted);\n    const a = AMPEL[(hit.json.property_ampel_inverter || '').trim()];\n    if (a && (!ampel || RANK[a] > (RANK[ampel] || 0))) ampel = a;\n  }\n  if (!matchedSeries.length || !ampel) ampel = ampel || SKIP_NOT_FOUND;\n}\n\nreturn [{\n  json: {\n    pageId,\n    inverterAmpel: ampel,\n    // Hersteller nur setzen, wenn die Serie in der DB gefunden wurde.\n    inverterManufacturers: matchedSeries.length ? [manufacturers[0]] : [],\n    inverterSeries: [...new Set(matchedSeries)],\n  },\n}];"
      },
      "id": "a0000000-0000-4000-9000-000000000031",
      "name": "Inverter Ampel zuordnen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        140
      ]
    },
    {
      "parameters": {
