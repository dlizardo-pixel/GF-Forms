          "name": "Notion OAuth2 API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Ampel Controller ermitteln und ALLE Werte fuer die Notion-Update-Node\n// bereitstellen. Hersteller/Serien werden nur uebernommen, wenn sie in der\n// Notion-DB existieren -> es entstehen keine neuen Multi-Select-Optionen.\n\nconst entries = $input.all();\nconst row = $('Loop Over Items').first().json;\nconst inv = $('Inverter Ampel zuordnen').first().json;\n\nconst norm = (s) => (s || '').trim().toLowerCase();\nconst split = (v) => (v || '').split(',').map((s) => s.trim()).filter(Boolean);\n\nconst manufacturers = split(row['Hersteller der Wärmepumpe']);\nconst seriesList = split(row['Wärmepumpen Controller (Modell- oder Serienname, z.B. ISG-Web)']);\n\nconst AMPEL = { '🟢': '🟢 Grün', '🟡': '🟡 Gelb', '🔴': '🔴 Rot' };\nconst RANK = { '🟢 Grün': 1, '🟡 Gelb': 2, '🔴 Rot': 3 };\nconst SKIP_NO_DATA = '⚪ Skipped: no manufacturer/series data';\nconst SKIP_NOT_FOUND = '⚪ Skipped: device not in Controller DB';\n\nlet ampel = null;\nconst matchedSeries = [];\n\nif (!manufacturers.length || !seriesList.length) {\n  ampel = SKIP_NO_DATA;\n} else {\n  for (const wanted of seriesList) {\n    const hit = entries.find((e) => {\n      const series = e.json.property_series || '';\n      const models = e.json.property_models || '';\n      if (series && norm(series) === norm(wanted)) return true;\n      return models.split(',').map((m) => m.trim()).some((m) => norm(m) === norm(wanted));\n    });\n    if (!hit) continue;\n    matchedSeries.push(hit.json.property_series || wanted);\n    const a = AMPEL[(hit.json.property_ampel_controller || '').trim()];\n    if (a && (!ampel || RANK[a] > (RANK[ampel] || 0))) ampel = a;\n  }\n  if (!ampel) ampel = SKIP_NOT_FOUND;\n}\n\n// Multi-Select-Werte als kommaseparierter String – so erwartet die Notion-Node sie.\nconst list = (arr) => [...new Set((arr || []).filter(Boolean))].join(',');\n\nreturn [{\n  json: {\n    pageId: $('Seite anlegen').first().json.id,\n    ampelInverter: inv.inverterAmpel || SKIP_NO_DATA,\n    ampelController: ampel,\n    inverterManufacturers: list(inv.inverterManufacturers),\n    inverterSeries: list(inv.inverterSeries),\n    hpManufacturers: list(matchedSeries.length ? [manufacturers[0]] : []),\n    hpControllerSeries: list(matchedSeries),\n    unternehmen: row['Ihr Unternehmen'] || '',\n    adresse: row['Adressen aller Gebäude mit gleichen Eigenschaften'] || '',\n  },\n}];"
      },
      "id": "a0000000-0000-4000-9000-000000000033",
      "name": "Controller Ampel zuordnen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
