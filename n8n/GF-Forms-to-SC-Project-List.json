    {
      "parameters": {
        "jsCode": "const controllerEntries = $input.all();\nconst controllerSeries = ($('Filter New Entries').first().json['Wärmepumpen Controller (Modell- oder Serienname, z.B. ISG-Web)'] || '').trim();\nconst scPageId = $('Create a database page').first().json.id;\nconst norm = (s) => (s || '').trim().toLowerCase();\nconst SKIP_NO_DATA = '⚪ Skipped: no manufacturer/series data';\nconst SKIP_NOT_FOUND = '⚪ Skipped: device not in Controller DB';\nconst ampelMap = { '🟢': '🟢 Grün', '🟡': '🟡 Gelb', '🔴': '🔴 Rot' };\nif (!controllerSeries) { return [{ json: { scPageId, ampelOption: SKIP_NO_DATA } }]; }\nlet matched = null;\nfor (const entry of controllerEntries) {\n  const series = entry.json.property_series || '';\n  const models = entry.json.property_models || '';\n  if (series && norm(series) === norm(controllerSeries)) { matched = entry; break; }\n  if (models.split(',').map(m => m.trim()).some(m => norm(m) === norm(controllerSeries))) { matched = entry; break; }\n}\nif (!matched) { return [{ json: { scPageId, ampelOption: SKIP_NOT_FOUND } }]; }\nconst ampelEmoji = matched.json.property_ampel_controller || '';\nconst ampelOption = ampelMap[ampelEmoji] || null;\nif (!ampelOption) { return [{ json: { scPageId, ampelOption: SKIP_NOT_FOUND } }]; }\nreturn [{ json: { scPageId, ampelOption } }];"
      },
