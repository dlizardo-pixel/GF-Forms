    {
      "parameters": {
        "jsCode": "const inverterEntries = $input.all();\nconst seriesModel = $('Filter New Entries').first().json['PV-Wechselrichter Modell / Serie']?.trim() || '';\nconst scPageId = $('Create a database page').first().json.id;\n\nconst norm = (s) => (s || '').trim().toLowerCase();\n\nconst SKIP_NO_DATA = '⚪ Skipped: no manufacturer/series data';\nconst SKIP_NOT_FOUND = '⚪ Skipped: device not in Inverter DB';\nconst ampelMap = { '🟢': '🟢 Grün', '🟡': '🟡 Gelb', '🔴': '🔴 Rot' };\n\nif (!seriesModel) {\n  return [{ json: { scPageId, ampelOption: SKIP_NO_DATA } }];\n}\n\nlet matched = null;\nfor (const entry of inverterEntries) {\n  const series = entry.json.property_series || '';\n  const models = entry.json.property_models || '';\n  if (series && norm(series) === norm(seriesModel)) { matched = entry; break; }\n  if (models.split(',').map(m => m.trim()).some(m => norm(m) === norm(seriesModel))) matched = entry;\n}\n\nif (!matched) {\n  return [{ json: { scPageId, ampelOption: SKIP_NOT_FOUND } }];\n}\n\nconst ampelEmoji = matched.json.property_ampel_inverter || '';\nconst ampelOption = ampelMap[ampelEmoji] || null;\nif (!ampelOption) {\n  return [{ json: { scPageId, ampelOption: SKIP_NOT_FOUND } }];\n}\nreturn [{ json: { matched: true, scPageId, ampelOption, ampelEmoji } }];"
      },
